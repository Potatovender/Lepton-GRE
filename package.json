{
  "name": "lepton-gre",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A browser-based mathematical field renderer with a Lepton text language and GLSL output.",
  "repository": "github:Potatovender/Lepton-GRE",
  "homepage": "https://potatovender.github.io/Lepton-GRE/",
  "bugs": "https://github.com/Potatovender/Lepton-GRE/issues",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "build": "node scripts/build.mjs",
    "test": "vitest run tests/expression-syntax.test.ts && npm run test:renderer",
    "test:renderer": "node --test packages/renderer/test/*.test.mjs",
    "test:browser": "node scripts/check-editor-browser.mjs && node scripts/check-collections-browser.mjs",
    "test:collections": "node scripts/check-collections-browser.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "npm run build && npm test && npm run typecheck",
    "migrate:samples": "node scripts/migrate-samples.mjs --write",
    "check:samples": "node scripts/migrate-samples.mjs",
    "update:mathquill": "node scripts/download-mathquill.mjs"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "playwright": "1.62.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "4.1.11"
  }
}
