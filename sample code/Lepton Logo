set x_min = -1
set x_max = 1
set y_min = -1
set y_max = 1
set max_recursion = 100
set angle_mode = radians
set background_color = 0
set ensure_square_grid = True
set aspect_ratio = 1:1
set draw_only_inside_boundary = False
set show_coordinate_grid = False
set show_grid = True
set show_x_axis = True
set show_y_axis = True
set show_x_numbers = True
set show_y_numbers = True
set unbounded_decimal_places = 3
set random_seed = 1
expression black = x^2+y^2-0.0225
expression spine = abs(2.5*x+y)-0.15
expression leg = abs(2.5*abs(x)+y)-0.15
expression rad = 200*sqrt(x^2+y^2)
expression f8 = x^4+y^4-0.1
expression outline1 = black-0.01
expression outline2 = spine-0.08
expression outline3 = leg-0.08
colour rgb = 255*e^(-0.02*x)~230*cos(frac{x}{70})~255
colour black = 1~1~1
boundary rest1 = 0-(spine)
boundary rest2 = 0-(leg)
boundary rest3 = 0-(black)
boundary border = f8
boundary outline = 0-(outline1)
boundary outline2 = 0-(outline2)
boundary outline3 = 0-(outline3)
draw(black,colour=black,boundary=outline)
draw(rad,colour=black,boundary=outline2)
draw(rad,colour=black,boundary=outline3)
draw(rad,colour=rgb,boundary=rest1)
draw(rad,colour=rgb,boundary=rest2)
draw(rad,colour=rgb,boundary=rest3)
draw(f8,colour=black,boundary=border)
