set x_min = -8
set x_max = 8
set y_min = -8
set y_max = 8
set max_recursion = 40
set angle_mode = radians
set background_color = 0
set ensure_square_grid = True
set aspect_ratio = 1:1
set draw_only_inside_boundary = False
expression rad = sqrt(x^2+y^2)
expression galaxy = 1/(1+0.08*x^2+0.42*y^2)
expression theta = arctan(y/(x+0.08))
expression arm = 0.5+0.5*sin(3*theta+2.4*rad)
expression core = 1/(1+0.45*rad^2)
expression dust = 1/(1+24*(abs(sin(12.7*x+2.1*sin(y)))+abs(cos(13.3*y+1.9*sin(x)))))
expression eq = galaxy*(0.35+0.65*arm)+core+0.45*dust*galaxy
expression r = 6+95*galaxy*arm+235*core+155*dust*galaxy
expression g = 10+70*galaxy*arm+145*core+145*dust*galaxy
expression b = 32+180*galaxy*arm+225*core+220*dust*galaxy
expression rest = 1
colour rgb = r~g~b
boundary rest = rest
draw(eq) {colour=rgb, boundary=rest}
